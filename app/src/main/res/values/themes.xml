<resources>
    <color name="colorPrimary">#3B9E23</color>
    <color name="rowSelected">#333B9E23</color>

    <!-- Light by default; values-night swaps only this parent, so the app follows the system setting. -->
    <style name="DayNightBase" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="AppTheme" parent="DayNightBase">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorPrimaryDark">@color/colorPrimary</item>
        <item name="android:colorAccent">@color/colorPrimary</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
    </style>

    <!-- White cursor and selection handles for the search box on the green bar. -->
    <style name="SearchField" parent="android:ThemeOverlay.Material.Dark">
        <item name="android:colorControlActivated">@android:color/white</item>
    </style>
</resources>
